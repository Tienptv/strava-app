                return;
            }

            actionButton.removeClass('disabled');
            toastBottom(response.msg || 'Đã xảy ra lỗi, vui lòng thử lại', 'danger');
        },
        complete: function() {
            $('#modalCancel button[type="submit"]').prop('disabled', false).removeClass('loading');
        },
        error: function(xhr, status, error) {
            actionButton.removeClass('disabled');
            let msg = xhr.responseJSON && xhr.responseJSON.msg ? xhr.responseJSON.msg : '';
            if ( msg ) {
