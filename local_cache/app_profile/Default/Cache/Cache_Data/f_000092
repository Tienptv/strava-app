$(document).on('click', '.users-address-validate', function () {
    const $btn = $(this);

    const ids = $btn.attr('data-ids');
    if ( !ids ) {
        toastBottom('Đã xảy ra lỗi không xác định', 'danger');
        return;
    }

    let htmlConfirmList = '';
    const $ulConfirm = $('#register-step-04-confirm').find('ul');
    $ulConfirm.empty();

    const arrIds = ids.split(',');
    const requiredFields = $btn.data('required');

    let flagError = 0;

    for ( let key of arrIds ) {
        if ( !key ) return;

        let $accordion = $('#accordion' + key);
        if ( !$accordion.length ) {
            $accordion = $btn.closest('#users-address-validate');
        }
        if ( !$accordion.length ) {
            $accordion = $btn.closest('.modal').find('#users-address-validate').first();
        }

        let title_ = $('#title-distance-' + key).text().trim();
        if ( title_ ) { title_ = 'Thông tin ' + title_; }

        let phoneValidate = '';

        $accordion.removeClass('is-invalid');

        /* default field */
        let arrField = requiredFields ? requiredFields.split(',').map(f => f.trim()) : [ 'name', 'last_name', 'phone', 'email', 'identification_number', 'nationality', 'nation', 'province', 'gender', 'dob', 't_shirt_size', 'emergency_contact_name', 'emergency_contact_phone' ];
        
        for ( let field of arrField ) {
            const $input = $('#' + field + '-' + key);
            if ( !$input.length || $input.hasClass('not-required') ) continue;

            const val = $.trim($input.val());
            $input.removeClass('is-invalid');

            const invalidate = (msg) => {
                $input.addClass('is-invalid').focus();
                $accordion.addClass('is-invalid');
                toastBottom(msg, 'danger');
                
                flagError = 1;
                return false;
            };

            if ( !val ) return invalidate(`Vui lòng nhập vào các trường bắt buộc ${title_}`);

            if ( field === 'phone' ) {
                const phoneClean = val.replace(/\s+/g, '');
                phoneValidate = phoneClean;

                if (!/^\d{10}$/.test(phoneClean)) {
                    return invalidate(`Số điện thoại không hợp lệ ${title_}`);
                }
            }

            if ( field === 'email' && !validateEmailStrict(val) )
                return invalidate(`Định dạng Email không hợp lệ ${title_}`);

            if ( field === 'email' && typeof isVnExpress !== 'undefined' && isVnExpress == 1 ) {
                const emailDomain = val.split('@').pop().toLowerCase();

                if ( /(^|\.)icloud\./.test(emailDomain) || /(^|\.)yahoo\./.test(emailDomain) )
                    return invalidate(`Email iCloud và Yahoo không hợp lệ cho giải VnExpress`);
            }

            if ( field === 'identification_number' ) {
                if ( !/^[a-zA-Z0-9]+$/.test(val) )
                    return invalidate(`CCCD hoặc hộ chiếu chỉ được nhập chữ và số ${title_}`);

                if ( val.length < 5 || val.length > 25 )
                    return invalidate(`CCCD hoặc hộ chiếu phải có từ 5 đến 25 ký tự ${title_}`);
            }

            if ( field === 'emergency_contact_phone' ) {
                if ( !/^\d{10}$/.test(val.replace(/\s+/g, '')) )
                    return invalidate(`Số điện thoại người liên lạc khẩn cấp không hợp lệ ${title_}`);
                if ( phoneValidate === val.replace(/\s+/g, '') )
                    return invalidate('Số điện thoại người liên lạc khẩn cấp không được trùng với SĐT cá nhân');
            }
        }

        /* check valid dob */
        const $dob = $('#dob-' + key);
        const $dobDisplay = $dob.siblings('input.flatpickr-input[type="text"]').first();
        const $dobFocus = $dobDisplay.length ? $dobDisplay : $dob;
        let dob = $dob.val();
        let age_as_of = parseInt($dob.attr('age-as-of') || 0);
        let age = dob ? getAge(dob, age_as_of) : 20;
        
        if ( arrField.includes('dob') && !dob ) {
            $dob.add($dobDisplay).addClass('is-invalid');
            $dobFocus.focus();
            toastBottom(`Vui lòng nhập vào các trường bắt buộc ${title_}`, 'danger');
            return false;
        }

        let minAge = parseInt($dob.attr('date-min-age') || 0);
        let maxAge = parseInt($dob.attr('date-max-age') || 0);

        if ( minAge && age < minAge ) {
            $dob.add($dobDisplay).addClass('is-invalid');
            $dobFocus.focus();
            $accordion.addClass('is-invalid');

            toastBottom(`${title_} người tham gia đăng ký phải trên ${minAge} tuổi`, 'danger');
            return false;
        }

        if ( maxAge && age > maxAge ) {
            $dob.add($dobDisplay).addClass('is-invalid');
            $dobFocus.focus();
            $accordion.addClass('is-invalid');

            toastBottom(`${title_} người tham gia đăng ký phải nhỏ hơn ${maxAge} tuổi`, 'danger');
            return false;
        }

        /* check valid guardian */
        const flagChild = Number($('#title-distance-' + key).data('child')) === 1;
        if ( age < 18 || flagChild ) {
            const guardianFields = [ 'guardian_name', 'guardian_identification_number', 'guardian_phone', 'guardian_email', 'guardian_dob', 'guardian_relationship' ];

            for ( let f of guardianFields ) {
                const $g = $('#' + f + '-' + key);
                if ( !$g.length ) continue;

                const $gDisplay = $g.siblings('input.flatpickr-input[type="text"]').first();
                const $gFocus = $gDisplay.length ? $gDisplay : $g;
                const val = $.trim($g.val());
                $g.add($gDisplay).removeClass('is-invalid');

                if ( !val ) {
                    $g.add($gDisplay).addClass('is-invalid');
                    $gFocus.focus();
                    $accordion.addClass('is-invalid');

                    toastBottom('Vui lòng nhập đầy đủ thông tin Phụ huynh/ Người giám hộ', 'danger');
                    return false;
                }

                if ( f === 'guardian_phone' && !/^\d{10}$/.test(val.replace(/\s+/g, ''))) {
                    $g.addClass('is-invalid');
                    $gFocus.focus();
                    $accordion.addClass('is-invalid');

                    toastBottom(`Số điện thoại Phụ huynh/ Người giám hộ không hợp lệ ${title_}`, 'danger');
                    return false;
                }

                if ( f === 'guardian_email' && !validateEmailStrict(val) ) {
                    $g.addClass('is-invalid');
                    $gFocus.focus();
                    $accordion.addClass('is-invalid');

                    toastBottom('Email Phụ huynh/ Người giám hộ không đúng', 'danger');
                    return false;
                }

                if ( f === 'guardian_identification_number' && (val.length < 5 || val.length > 20) ) {
                    $g.addClass('is-invalid');
                    $gFocus.focus();
                    $accordion.addClass('is-invalid');
                    
                    toastBottom('CCCD Phụ huynh/ Người giám hộ không hợp lệ', 'danger');
                    return false;
                }

                if ( f === 'guardian_dob' && getAge(val) < 18 ) {
                    $g.add($gDisplay).addClass('is-invalid');
                    $gFocus.focus();
                    $accordion.addClass('is-invalid');

                    toastBottom('Phụ huynh/ Người giám hộ phải đủ 18 tuổi', 'danger');
                    return false;
                }
            }
        }

        /* check acf */
        if ( $accordion.find('#events-custom-field').length ) {
            $accordion.find('#events-custom-field .form-control').each(function () {
                let $input = $(this);
                let value = $.trim($input.val());
                let formatter = $input.attr('data-formatter') || 'text';

                $input.removeClass('is-invalid');

                const invalidateAcf = (message) => {
                    $input.addClass('is-invalid').focus();
                    $accordion.addClass('is-invalid');
                    toastBottom(message, 'danger');

                    flagError = 1;
                    return false;
                };

                if ( !$input.hasClass('not-required') && !value ) {
                    return invalidateAcf(`Vui lòng nhập vào các trường bắt buộc ${title_}`);
                }

                if ( !value ) return;

                if ( formatter === 'hh:mm' ) {
                    let time = parseEventCustomFieldTime(value);
                    if ( !time ) {
                        return invalidateAcf(`Thời gian phải đúng định dạng hh:mm ${title_}`);
                    }

                    let distance = ($input.attr('data-distance') || '').toLowerCase();
                    let timeLimit = getEventCustomFieldTimeLimit(distance);

                    if ( time.totalMinutes > timeLimit.totalMinutes ) {
                        let distanceText = distance ? ` cho cự ly ${distance}` : '';
                        return invalidateAcf(`Thời gian tối đa ${distanceText} là ${timeLimit.label} ${title_}`);
                    }

                    if ( time.minutePart > 59 ) {
                        return invalidateAcf(`Thời gian phải đúng định dạng hh:mm ${title_}`);
                    }
                }

                if ( formatter === 'url' && !isValidHttpsUrl(value) ) {
                    return invalidateAcf(`Liên kết không đúng định dạng ${title_}`);
                }
            });
        }

        if ( flagError == 1 ) return false;

        /* check valid pet */
        const petFields = [
            { id: 'pet-type-', cls: 'pet-type' },
            { id: 'pet-name-', cls: 'pet-name', trim: true },
            { id: 'pet-weight-', cls: 'pet-weight', trim: true },
            { id: 'pet-vaccin-', cls: 'pet-vaccin', checkbox: true }
        ];

        for ( let f of petFields ) {
            const $el = $('#' + f.id + key);
            if ( !$el.length ) continue;

            const $wrap = $('#pet-field-' + key + ' .' + f.cls);
            $wrap.removeClass('is-invalid');

            if ( f.checkbox && !$el.is(':checked') ) {
                $wrap.addClass('is-invalid').focus();
                $accordion.addClass('is-invalid');

                toastBottom(`Vui lòng xác nhận thú cưng đã tiêm chủng ở khung ${title_}`, 'danger');
                return false;
            }

            let val = f.trim ? $.trim($el.val()) : $el.val();
            if ( !f.checkbox && !val ) {
                $wrap.addClass('is-invalid').focus();
                $accordion.addClass('is-invalid');

                toastBottom(`Vui lòng nhập Thông tin thú cưng ở khung ${title_}`, 'danger');
                return false;
            }
        }

        /* check required addons */
        const $requiredAddonGroups = $('#users-address-validate .addon-items[data-addon-required="1"]');
        if ( $requiredAddonGroups.find('.addon-item').length && !$requiredAddonGroups.find('.addon-checkbox:checked').length ) {
            $requiredAddonGroups.addClass('is-invalid');
            $accordion.addClass('is-invalid');

            const $firstAddon = $requiredAddonGroups.find('.addon-item').first();
            if ( $firstAddon.length ) {
                $('html, body').animate({ scrollTop: $firstAddon.offset().top - 140 }, 250);
            }

            toastBottom(`Vui lòng chọn ít nhất 1 dịch vụ Lưu trú hoặc Di chuyển ${title_}`, 'danger');
            return false;
        }

        /* check valid confirm vaccination */
        if ( $('#agree-confirm_vaccination-' + key).length ) {
            let $el = $('#agree-confirm_vaccination-' + key);
            $el.removeClass('is-invalid');

            if ( !$el.is(':checked') ) {
                $el.addClass('is-invalid').focus();
                $accordion.addClass('is-invalid');

                toastBottom('Vui lòng xác nhận điều khoản và điều kiện', 'danger');
                return false;
            }
        }

        /* check valid disclaimer */
        if ( $('#agree-disclaimer-' + key).length ) {
            let $el = $('#agree-disclaimer-' + key);
            $el.removeClass('is-invalid');

            if ( !$el.is(':checked') ) {
                $el.addClass('is-invalid').focus();
                $accordion.addClass('is-invalid');

                toastBottom('Vui lòng xác nhận điều khoản và điều kiện', 'danger');
                return false;
            }
        }

        /* */
        const $form = $('#users-address-validate');
        const $dobInputs = $form.find('input.dob-main[id]');
        const $ageSelects = $form.find('select.age-group');

        if ( $('#min-children').length ) {
            const minChildrenRequired = parseInt($('#min-children').val(), 10);

            let under18FromDob = 0;
            let under18FromSelect = 0;
            let hasInvalidChildAge = false;

            $dobInputs.each(function () {
                const $input = $(this);
                
                const dob = $input.val();
                if ( !dob ) return;

                let minRequired = 0;
                let maxRequired = 18;

                if ( typeof childAgeLimit !== 'undefined' ) {
                    minRequired = childAgeLimit.min;
                    maxRequired = childAgeLimit.max;
                }

                if ( $input.is('[date-min-age]') && $input.is('[date-max-age]') ) {
                    minRequired = parseInt($input.attr('date-min-age'), 10);
                    maxRequired = parseInt($input.attr('date-max-age'), 10);
                }

                $input.removeClass('is-invalid');

                const ageAsOf = parseInt($input.attr('age-as-of') || 0);
                const age = getAge(dob, ageAsOf);
                if ( age < maxRequired ) {
                    under18FromDob++;

                    if ( age < minRequired || age > maxRequired ) {
                        $input.addClass('is-invalid');
                        hasInvalidChildAge = true;
                    }
                }
            });

            $ageSelects.each(function () {
                if ( $(this).val() === '1' ) under18FromSelect++;
            });

            if ( hasInvalidChildAge ) {
                toastBottom(`Trẻ em phải trong độ tuổi từ ${childAgeLimit.min} đến ${childAgeLimit.max} tuổi (*)`, 'danger');
                return false;
            }
            
            if ( under18FromDob < minChildrenRequired ) {
                toastBottom(`Cần phải có ít nhất ${minChildrenRequired} Kid (trẻ em) để hoàn tất đăng ký (*)`, 'danger');
                return false;
            }
        }

        if ( $('#min-adults').length ) {
            const minAdultsRequired = parseInt($('#min-adults').val(), 10);
            let adultsFromDob = 0;
            let adultsFromSelect = 0;

            $dobInputs.each(function () {
                const dob = this.value;
                if ( dob && getAge(dob) >= 18 ) adultsFromDob++;
            });

            $ageSelects.each(function () {
                if ($(this).val() === '0') adultsFromSelect++;
            });

            if ( adultsFromDob < minAdultsRequired ) {
                toastBottom(`Cần phải có ít nhất ${minAdultsRequired} người trên 18 tuổi để hoàn tất đăng ký (*)`, 'danger');
                return false;
            }
        }

        /* modal confirm */
        htmlConfirmList += ` <li> <strong>${($('#title-distance-' + key).text().trim()).split('-')[0].trim()}:</strong> ${$.trim($('#name-' + key).val() || '')} - <span class="text-primary"> ${$.trim($('#email-' + key).val() || '')} </span> </li> `;
    }

    if ( $btn.data('quick-checkout') !== undefined ) {
        const must = (id, msg, type = null) => {
            const $el = $(id);
            let val = ($el.val() || '').trim();

            $el.removeClass('is-invalid');

            if ( !val ) {
                $el.addClass('is-invalid').focus();
                toastBottom(msg, 'danger');
                return false;
            }

            if ( type === 'email' && !validateEmailStrict(val) ) {
                $el.addClass('is-invalid').focus();
                toastBottom('Email không hợp lệ', 'danger');
                return false;
            }

            if ( type === 'phone' && !/^\d{10}$/.test(val.replace(/\s+/g, '')) ) {
                $el.addClass('is-invalid').focus();
                toastBottom('Số điện thoại không hợp lệ', 'danger');
                return false;
            }

            return true;
        };

        if ( !must('#buyer-name', 'Vui lòng nhập Họ & tên người mua') ) return false;
        if ( !must('#buyer-email', 'Vui lòng nhập Email người mua', 'email') ) return false;
        if ( !must('#buyer-phone', 'Vui lòng nhập SĐT người mua', 'phone') ) return false;

        if ( $('#buyer-vat').is(':checked') ) {
            const vatFields = [
                {id: '#vat_company_name', msg: 'Vui lòng nhập tên công ty'},
                {id: '#vat_tax_code', msg: 'Vui lòng nhập mã số thuế'},
                {id: '#vat_company_address', msg: 'Vui lòng nhập địa chỉ công ty'},
                {id: '#vat_name_of_recipient', msg: 'Vui lòng nhập họ tên người nhận'},
                {id: '#vat_phone_of_recipient', msg: 'Vui lòng nhập số điện thoại người nhận', type: 'phone'},
                {id: '#vat_email_of_recipient', msg: 'Vui lòng nhập email người nhận', type: 'email'}
            ];

            for ( let f of vatFields ) {
                if ( !must(f.id, f.msg, f.type) ) return false;
            }

            if ( !$('#buyer-vat-confirm').is(':checked') ) {
                $('#buyer-vat-confirm').addClass('is-invalid').focus();
                toastBottom('Vui lòng xác nhận thông tin xuất hóa đơn', 'danger');
                return false;
            }
        }

        /* ===== payment ===== */
        if ( !$('input[name="payment"]:checked').length ) {
            toastBottom('Vui lòng chọn phương thức thanh toán', 'danger');
            return false;
        }
    }

    if ( $('#register-step-04-confirm').length ) {
        $ulConfirm.html(htmlConfirmList);
        $('#register-step-04-confirm').modal('show');
        return;
    }

    $('#users-address-validate').trigger('submit');
});

