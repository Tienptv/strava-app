$('#users-address-validate').on('change', '.age-group', function () {
    let selectedValue = $(this).val();
    let key = $(this).data('key');
    let titleTarget = $('#title-distance-' + key);

    if ( selectedValue == 1 ) {
        titleTarget.attr('data-child', '1');
        toggleDangerLabels(key, true);
        $('.guardian-field-' + key).removeClass('d-none');
    } else {
        titleTarget.removeAttr('data-child');
        toggleDangerLabels(key, false);
        $('.guardian-field-' + key).addClass('d-none');
    }

    /* */
    let minRequired = 0;
    let maxRequired = 18;

    if ( typeof childAgeLimit !== 'undefined' ) {
        minRequired = childAgeLimit.min;
        maxRequired = childAgeLimit.max;
    }

    let $dobInput = $('#dob-' + key);
    let $dobDisplayInput = $dobInput.siblings('input.flatpickr-input[type="text"]').first();
    if ( !$dobDisplayInput.length ) $dobDisplayInput = $dobInput;
    let dobVal = $dobInput.val();
    let dobDisplayVal = $.trim($dobDisplayInput.val());

    if ( dobDisplayVal && (!dobVal || !isValidDateInput(dobDisplayVal)) ) {
        $('#age_group-' + key).removeClass('is-invalid').siblings('.age-error').remove();
        return false;
    }

    if ( $dobInput.is('[date-min-age]') && 
        $dobInput.is('[date-max-age]') &&
        parseInt($dobInput.attr('date-min-age'), 10) > 0 &&
        parseInt($dobInput.attr('date-max-age'), 10) > 0 ) {
        minRequired = parseInt($dobInput.attr('date-min-age'), 10);
        maxRequired = parseInt($dobInput.attr('date-max-age'), 10);
    }

    $dobInput.siblings('.age-error').remove();
    $dobInput.removeClass('is-invalid');
    $('#age_group-' + key).siblings('.age-error').remove();
    $('#age_group-' + key).removeClass('is-invalid');

    if ( dobVal ) {
        let ageAsOf = parseInt($dobInput.attr('age-as-of') || 0);
        let age = getAge(dobVal, ageAsOf);
        let errorMessage = '';
        
        if ( selectedValue == '1' && ( age > maxRequired || age < minRequired ) ) {
            errorMessage = `Độ tuổi không chính xác, nhóm Đối tượng trẻ em dành cho thành viên `;

            if ( minRequired == 0 ) {
                errorMessage += `nhỏ hơn ${maxRequired} tuổi`;
            } else {
                errorMessage += `từ ${minRequired} đến ${maxRequired} tuổi`;
            }
        }

        if ( selectedValue == '0' && age < maxRequired ) {
            errorMessage = `Độ tuổi không chính xác, nhóm Đối tượng người lớn dành cho thành viên trên ${maxRequired} tuổi`;
        }

        if ( errorMessage !== '' ) {
            $('<em class="mt-1 d-block text-danger line-1-2 age-error"> <small>' + errorMessage + '</small> </em>').insertAfter($dobDisplayInput);
            $dobInput.addClass('is-invalid');
            $('<em class="mt-1 d-block text-danger line-1-2 age-error"><small>' + errorMessage + '</small></em>').insertAfter($('#age_group-' + key));
            $('#age_group-' + key).addClass('is-invalid');
        }
    }

    /* */
    let $select = $('#t_shirt_size-' + key);
    if ( $select.length && selectedValue == 1 ) {
        let $options = $select.find('option');
        $options.each(function () {
            $(this).toggle($(this).hasClass('child'));
        });

        if ( !$select.find('option:selected').is(':visible') ) {
            $select.val('');
        }
    } else {
        let $options = $select.find('option');
        $options.each(function () {
            $(this).toggle(!$(this).hasClass('child'));
        });

        if ( !$select.find('option:selected').is(':visible') ) {
            $select.val('');
        }
    }
});

function toggleDangerLabels(key, hide) {
    const fields = ['phone', 'identification_number'];

    fields.forEach(function(field) {
        const inputId = `${field}-${key}`;
        const input = $(`#${inputId}`);
        const label = $(`label[for="${inputId}"]`);

        if ( hide ) {
            label.find('small.text-danger').addClass('d-none');
            if ( input.hasClass('is-invalid') ) {
                input.removeClass('is-invalid');
            }
        } else {
            label.find('small.text-danger').removeClass('d-none');
        }
    });
}

