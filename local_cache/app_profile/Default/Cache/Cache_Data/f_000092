            if ( hideTShirt == 1 ) {
                fields = fields.filter(f => f !== 't_shirt_size');
            }

            fields.forEach(field => {
                const selector = `#${field}-${key}`;
                let value = response[field] || '';

                if ( field === 'bib_name' && typeof isVnExpress !== 'undefined' && isVnExpress == 1 ) {
                    value = sanitizeVnExpressBibName(value);
                }

                if ( field === 't_shirt_size' && typeof tShirtSizeLimit !== 'undefined' && typeof tShirtSizeLimit === 'object' ) {
                    const limit = tShirtSizeLimit[value];
                    if ( typeof limit !== 'undefined' ) {
                        const selectedCount = $('.select-t-shirt-size').filter(function () {
                            return $(this).val() === value;
                        }).length;

                        if ( parseInt(limit) <= selectedCount ) {
                            toastBottom(`Không thể chọn Size áo vì đã đạt giới hạn`, 'danger');
                            return;
                        }
                    }
                }

                const element = document.querySelector(selector);
                if ( field === 'blood' && value && element instanceof HTMLSelectElement ) {
                    const hasBloodOption = Array.from(element.options).some(option => String(option.value) === String(value));
                    if ( !hasBloodOption ) return;
                }

                if ( ['dob', 'guardian_dob'].includes(field) && element && element._flatpickr ) {
                    const dateFormat = String(value).includes('/')
                        ? element._flatpickr.config.altFormat
                        : element._flatpickr.config.dateFormat;

                    if ( value ) {
                        element._flatpickr.setDate(value, true, dateFormat);
                    } else {
                        element._flatpickr.clear(true);
                    }
                    return;
                }

                $(selector).val(value);
                if ( field === 'club' ) {
                    $(selector).trigger('change');
                }
            });

            $('.collapse' + key + ' .card-body').removeClass('loading');
            $('.dropdown-toggle.' + key).html(text_);
        },
        complete: function (xhr, status) { 
            $('.collapse' + key + ' .card-body').removeClass('loading');
