$(document).ready(function () {
    const $offcanvasBody = $('.offcanvas-body');
    const $menu = $offcanvasBody.find('.bg-dark-78');
    const $navItems = $menu.find('> .nav-item');
    const $indicator = $('<div>').addClass('nav-indicator').appendTo($menu);

    let $activeItem = $navItems.first();
    let firstRender = true;

    function moveIndicatorTo($item) {
        const itemRect = $item[0].getBoundingClientRect();
        const parentRect = $menu[0].getBoundingClientRect();

        const indicatorWidth = itemRect.width * 0.7;
        const indicatorLeft = itemRect.left - parentRect.left + (indicatorWidth * 0.2);

        if ( firstRender ) {
            $indicator.css('transition', 'none');
        }

        $indicator.css({
            'width': indicatorWidth + 'px',
            'left': indicatorLeft + 'px',
            'opacity': '1',
            'transform': 'translateX(0)'
        });

        if ( firstRender ) {
            requestAnimationFrame(() => {
                $indicator.css('transition', 'all 0.4s ease');
                firstRender = false;
            });
        }
    }

    moveIndicatorTo($activeItem);

    $navItems.each(function () {
        const $item = $(this);

        $item.on('mouseenter', function () {
            moveIndicatorTo($item);
        });
        $item.on('mouseleave', function () {
            if (!$indicator.data('locked')) {
                moveIndicatorTo($activeItem);
            }
        });
        $item.find('a').on('click', function () {
            $activeItem = $item;
            $indicator.data('locked', true);
        });
    });

    $menu.on('mouseleave', function () {
        if ( !$indicator.data('locked') ) {
            moveIndicatorTo($activeItem);
        }
    });

    $(window).on('resize', function () {
        moveIndicatorTo($activeItem);
    });

    /* */
    let $header = $('.header-sticky');
    let $wrapper = $('.wrapper');
    function updateHeaderClass() {
        let scrollTop = $(window).scrollTop();
        let windowWidth = $(window).width();
        $header.removeClass('bg-white bg-soft-backdrop-filter bg-transparent has-shadow');
        $wrapper.removeClass('has-header-sticky');
    
        if ( scrollTop > 750 ) {
            $header.addClass('bg-white has-shadow');
            $wrapper.addClass('has-header-sticky');
        } else if ( scrollTop > 10 ) {
            if ( windowWidth >= 1024 ) {
                $header.addClass('bg-soft-backdrop-filter has-shadow');
                $wrapper.addClass('has-header-sticky');
            } else {
                $header.addClass('bg-white has-shadow');
            }
        } else {
            $header.addClass('bg-transparent');
        }
    }
    
    $(window).on('scroll', updateHeaderClass);
    updateHeaderClass();
});

