function deleteGroupbuyItem(item) {
    let comboID = item.attr('data-combo');
    let accordions = $('#form-groupbuy #accordion' + item.attr('data-key'));

    if ( comboID ) {
        accordions = $('#form-groupbuy .accordion-wrapper').filter(function() {
            return $(this).hasClass('combo-' + comboID);
        });
    }

    let ticketCounts = {};
    accordions.find('i.delete-item[data-ticket]').each(function() {
        let ticketID = $(this).attr('data-ticket');
        ticketCounts[ticketID] = (ticketCounts[ticketID] || 0) + 1;
    });

    accordions.remove();
    updateDataIDsinFormGroupbuy();

    let totalRemoved = 0;
    Object.keys(ticketCounts).forEach(function(ticketID) {
        let count = ticketCounts[ticketID];
        let input = $('.spinner-input.' + ticketID);
        totalRemoved += count;

        input.length && input.val(Math.max((parseInt(input.val(), 10) || 0) - count, 0)).trigger('change');

        let numericTicketID = Number(ticketID);
        if ( sentTickets.has(numericTicketID) ) {
            sentTickets.set(numericTicketID, Math.max(sentTickets.get(numericTicketID) - count, 0));
        }
    });

    let strong = $('.groupbuy-ticket-total');
    if ( strong.length && totalRemoved ) {
        strong.text(Math.max((parseInt(strong.text(), 10) || 0) - totalRemoved, 0));
    }
}

