const eventCustomFieldTimeSelector = '#events-custom-field input[data-formatter="hh:mm"][data-distance]';
const eventCustomFieldDefaultTimeLimit = '06:30';
const eventCustomFieldTimeLimits = {
    '42km': '06:30',
    '21km': '03:30',
    '10km': '02:00',
    '5km': '01:15'
};

function formatEventCustomFieldTime(input) {
    let digits = input.value.replace(/\D/g, '').slice(0, 4);
    input.value = digits.length > 2
        ? digits.slice(0, 2) + ':' + digits.slice(2)
        : digits;
}

function parseEventCustomFieldTime(value) {
    let matches = value.match(/^(\d{2}):(\d{2})$/);
    if ( !matches ) return null;

    let hours = Number(matches[1]);
    let minutes = Number(matches[2]);

    return {
        minutePart: minutes,
        totalMinutes: (hours * 60) + minutes
    };
}

function getEventCustomFieldTimeLimit(distance) {
    let label = eventCustomFieldTimeLimits[distance] || eventCustomFieldDefaultTimeLimit;
    let parts = label.split(':').map(Number);

    return {
        label: label,
        totalMinutes: (parts[0] * 60) + parts[1]
    };
}

function isValidHttpsUrl(value) {
    try {
        let url = new URL(value);
        return url.protocol === 'https:' && !!url.hostname;
    } catch (error) {
