let sentTickets = new Map();

function getSelectedTickets() {
    let ticketIDs = [];
    let qtys = [];
    let totalQty = 0;
    let needSignIn = false;

    $('.groupbuy-ticket-wrapper .spinner input.spinner-input').each(function() {
        let value = parseInt($(this).val(), 10);
        let dataId = $(this).data('id');

        if ( !dataId || isNaN(dataId) || dataId <= 0 ) {
            needSignIn = true;
            return false;
        }

        if ( value > 0 ) {
            ticketIDs.push(dataId);
            qtys.push(value);
            totalQty += value;
        }
    });

    if ( needSignIn && $('#modal-signin').length ) {
        if ( !window.__justShowedModal__ ) {
            window.__justShowedModal__ = true;
            setTimeout(() => {
                $('button.decrease').trigger('click');
                $('#modal-signin').modal('show');
                window.__justShowedModal__ = false;
            }, 100);
        }
    }

    return { ticketIDs, qtys, totalQty };
}

$(document).on('click', '.groupbuy-ticket-wrapper .spinner button.decrease', function(event) {
    let $input = $(this).next('.spinner-input');
    let ticketID = Number($input.data('id'));
    let currentValue = Number($input.val());

    if ( sentTickets.has(ticketID) && currentValue < sentTickets.get(ticketID) ) {
        $input.next('button.increase').trigger('click');
    }

    let { totalQty } = getSelectedTickets();
    $('.groupbuy-ticket-total').html(totalQty);
});

$(document).on('click', '.groupbuy-ticket-wrapper .spinner button.increase', function(event) {
    let { totalQty } = getSelectedTickets();
    $('.groupbuy-ticket-total').html(totalQty);
});

$(document).on('click', '#groupbuy-ticket-confirm', function() {
    let { ticketIDs, qtys, totalQty } = getSelectedTickets();
    let id = $(this).attr('data-id');
    let url = $(this).attr('data-url');
    
    if ( !id || isNaN(id) || id <= 0 ) { return false; }
    
    if ( ticketIDs.length <= 0 ) {
        toastBottom('Vui lòng chọn số lượng để tiếp tục');
        return false;
    }

    /* filter the difference */
    let newTicketIDs = [];
    let newQtys = [];

    ticketIDs.forEach((id, index) => {
        let currentQty = qtys[index];
        let previousQty = sentTickets.get(id) || 0;
        let diffQty = currentQty - previousQty;

        if ( diffQty > 0 ) {
            newTicketIDs.push(id);
            newQtys.push(diffQty);
        }
    });

    if ( newTicketIDs.length === 0 ) { return false; }

    $.ajax({
        url: url,
        cache: false,
        type: 'post',
        data: {
            id: id,
            ticket: newTicketIDs,
            qty: newQtys,
            start_key: sessionStorage.start_key,
            [csrfName]: csrfToken
        },
        beforeSend: function() {
            $('#groupbuy-ticket-confirm').addClass('loading');
            
            if ( sessionStorage.start_key ) {
                sessionStorage.start_key = parseInt(sessionStorage.start_key) + parseInt(totalQty);
            }

            /* update sent list */
            newTicketIDs.forEach((id, index) => {
                let updatedQty = (sentTickets.get(id) || 0) + newQtys[index];
                sentTickets.set(id, updatedQty);
            });
        },
        success: function (resp) {
            $('#form-groupbuy').append(resp);
            initFlatpickrs(document.getElementById('form-groupbuy'));
            
            document.querySelectorAll('#form-groupbuy select.dselect').forEach((item) => {
                if ( !item.dataset.dselectInit ) {
                    dselect(item, { search: true });
                    item.dataset.dselectInit = 'true';
                }
            });

            theme.lightbox();
            updateDataIDsinFormGroupbuy();
            
            $('html, body').animate({
                scrollTop: $('#users-address-validate').offset().top - 150
            }, 300);
        },
        complete: function (xhr, status) {
            $('#form-groupbuy .event-summary').remove();
            $('#form-groupbuy .alert.alert-warning.first').remove();
            $('#form-groupbuy + .form-floating').removeClass('d-none');
            $('#groupbuy-ticket-confirm').removeClass('loading');
        },
        error: handleAjaxError
    })
    .done(function( html ) { });
});

