if ( typeof tShirtSizeLimit !== 'undefined' && typeof tShirtSizeLimit === 'object' ) {
    function countSelected(id) {
        let count = 0;
        $('.select-t-shirt-size').each(function () {
            if ( $(this).val() === id ) count++;
        });
        return count;
    }

    function updateOptionsVisibility() {
        $('.select-t-shirt-size').each(function () {
            const $select = $(this);
            const currentVal = $select.val();

            $select.find('option').each(function () {
                const $option = $(this);
                const optionVal = $option.attr('value');

                if ( !optionVal ) return;

                const limit = tShirtSizeLimit[optionVal];
                if ( typeof limit !== 'undefined' ) {
                    const selectedCount = countSelected(optionVal);

                    if ( limit === '0' ) {
                        $option.hide();
                        if ( currentVal === optionVal ) {
                            $select.val('');
                        }
                    } else if ( selectedCount >= parseInt(limit) && currentVal !== optionVal ) {
                        $option.hide();
                    } else {
                        $option.show();
                    }
                } else {
                    $option.show();
                }
            });
        });
    }

    $('.select-t-shirt-size').on('change', function () {
        updateOptionsVisibility();
    });
    updateOptionsVisibility();
}

