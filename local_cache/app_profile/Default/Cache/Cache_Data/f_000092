function validateEmailStrict(email) {
    let regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if ( !regex.test(email) ) return false;

    let parts = email.split('@');
    if ( parts.length !== 2 ) return false;

    let local = parts[0];
    let domain = parts[1].toLowerCase();

    if ( local.length < 1 ) return false;
    if ( domain.indexOf('.') === -1 ) return false;
    if ( domain.startsWith('.') || domain.endsWith('.') ) return false;

    let invalidChars = /[,\+\`\~\!\#\$\%\^\&\*\(\)\=\{\}\[\]\|\\\:;\"\'\<\>\?\/]/;
    if ( invalidChars.test(email) ) return false;

    let commonTypos = [
        /* gmail */
        'gmail.co', 'gmail.con', 'gmail.coom', 'gmail.comm', 'gmail.cm', 'gmail.vom', 'gmail.om',
        'gmai.com', 'gmial.com', 'gnail.com', 'gmal.com', 'gmaill.com', 'gma.com', 'gamil.com', 'gmil.com', 'gail.com',
        'gmal.cmo', 'gmail.cmo', 'gmaill.con', 'gmail.ccom', 'gmmail.com', 'hmail.com', 'gmail.com.vn', 'googlemail.com', 'mail.com',
        /* hotmail */
        'hotmal.com', 'hotmial.com', 'hotmai.com', 'hotmil.com', 'hotmaill.com', 'homail.com',
        'hotmail.co', 'hotmail.con', 'hotmail.coom', 'hotmal.co', 'hotmial.con', 'hotmal.cmo',
        /* yahoo */
        'yahho.com', 'yhoo.com', 'yaoo.com', 'yaho.com', 'yaho.co', 'yahoo.co', 'yahoo.con', 'yahoo.coom',
        'yhoo.co', 'yhoo.con', 'yahho.cmo',
        /* outlook */
        'outlok.com', 'outllok.com', 'outluk.com', 'outloook.com',
        'outlook.co', 'outlook.con', 'outlook.coom',
        'outlok.co', 'outlok.con', 'outluk.con', 'outllok.cmo',
        /* iCloud */
        'iclod.com', 'icluod.com', 'iclaud.com', 'iclud.com', 'icload.com', 'icould.com', 'icoud.com',
        'icloud.co', 'icloud.con', 'icluod.con', 'icloud.coom', 'icluod.cmo', 'me.com',
        /* dot com */
        '.comm', '.ccom', '.coom', '.cmo'
    ];

    if ( commonTypos.includes(domain) ) { return false; }
    return true;
}

function getAge(dateString, age_as_of = 0) {
    let day, month, year;
    
    if ( dateString.includes('/') ) {
        [day, month, year] = dateString.split('/').map(Number);
    } else {
        [year, month, day] = dateString.split('-').map(Number);
    }

    const birthDate = new Date(year, month - 1, day);

    let today;

    if ( age_as_of && age_as_of !== 0 ) {
        today = new Date(
            age_as_of < 10000000000
                ? age_as_of * 1000
                : age_as_of
        );
    } else {
        today = new Date();
    }

    let age = today.getFullYear() - birthDate.getFullYear();

    if ( today.getMonth() < birthDate.getMonth() ||
        (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate())
    ) {
        age--;
    }

    /*
     * Keep the completed years, but include the progress toward the next
     * birthday. Age limits are exact-date limits: max age 6 ends after the
     * sixth birthday, instead of lasting until the seventh birthday.
     */
    const lastBirthday = new Date(
        birthDate.getFullYear() + age,
        birthDate.getMonth(),
        birthDate.getDate()
    );
    const nextBirthday = new Date(
        birthDate.getFullYear() + age + 1,
        birthDate.getMonth(),
        birthDate.getDate()
    );

    if ( today > lastBirthday ) {
        age += (today - lastBirthday) / (nextBirthday - lastBirthday);
    }

    return age;
}

function fallbackCopyTextToClipboard(text) {
    let textArea = document.createElement('textarea');
    textArea.value = text;

    textArea.style.top = 0;
    textArea.style.left = 0;
    textArea.style.position = 'fixed';

    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();

    try {
        let successful = document.execCommand('copy');
        let msg = successful ? 'successful' : 'unsuccessful';
        console.log('Fallback: Copying text command was ' + msg);
    } catch (err) {
        console.error('Fallback: Oops, unable to copy', err);
    }

    document.body.removeChild(textArea);
}

function copyTextToClipboard(text) {
    if ( !navigator.clipboard ) {
        fallbackCopyTextToClipboard(text);
        return;
    }

    navigator.clipboard.writeText(text).then(function() {
        console.log('Async: Copying to clipboard was successful!');
    }, function(err) {
        console.error('Async: Could not copy text: ', err);
    });	
}

