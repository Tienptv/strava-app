$(document)
.off('click.cancelRegistration', '.js-cancel-registration')
.on('click.cancelRegistration', '.js-cancel-registration', function(e) {
    e.preventDefault();

    let button = $(this);
    let modal = $('#modalCancel');
    let type = button.attr('data-type') || '';
    let id = button.attr('data-id') || 0;
    let checkUrl = modal.attr('data-check-url') || '';
    let fields = {
        '#cancel-payment-no': '#' + (button.attr('data-payment-no') || '__'),
        '#cancel-distance': button.attr('data-distance') || '__',
        '#cancel-fullname': button.attr('data-fullname') || '__',
        '#cancel-email': button.attr('data-email') || '__',
        '#cancel-phone': button.attr('data-phone') || '__'
    };

    modal.data('cancel-registration-button', button);

    Object.keys(fields).forEach(function(selector) {
        modal.find(selector).text(fields[selector]);
    });

    modal.find('#type').val(type);
    modal.find('#type_id').val(id);
    modal.find('#cancel-reason').val('').removeClass('is-invalid');
    modal.find('#cancel-image').val('').removeClass('is-invalid').prop('readonly', false);
    modal.find('button[type="submit"]').prop('disabled', true).removeClass('loading');
    modal.find('#cancel-registration-payment-summary').html('<p class="mb-0">Đang tải số tiền hoàn dự kiến...</p>');
    modal.modal('show');

    if ( cancelRegistrationCheckRequest ) {
        cancelRegistrationCheckRequest.abort();
    }

    if ( !checkUrl || !type || !id ) {
        showCancelRegistrationCheckError();
        return;
    }

    let request = $.ajax({
        url: checkUrl,
        cache: false,
        type: 'post',
        dataType: 'json',
        data: {
            type: type,
            type_id: id,
            [csrfName]: csrfToken
        },
        success: function(response) {
            if ( response.status !== 'success' || !response.data ) {
                showCancelRegistrationCheckError(response.msg);
                return;
            }

            renderCancelRegistrationPaymentSummary(response.data);
        },
        error: function(xhr, status) {
            if ( status !== 'abort' ) {
                showCancelRegistrationCheckError();
            }
        },
        complete: function() {
            if ( cancelRegistrationCheckRequest === request ) {
                cancelRegistrationCheckRequest = null;
            }
        }
    });
    cancelRegistrationCheckRequest = request;
});

function validateCancelRegistrationReason(textarea, showToast = true) {
    let value = $.trim($(textarea).val() || '');

    if ( !value ) {
        $(textarea).addClass('is-invalid');
        if ( showToast ) {
            toastBottom('Vui lòng nhập lý do hủy', 'danger');
        }
        return false;
    }

    $(textarea).removeClass('is-invalid');
    return true;
}

function validateCancelRegistrationImage(input, showToast = true) {
    if ( !input.files || !input.files.length ) {
        $(input).addClass('is-invalid');
        if ( showToast ) {
            toastBottom('Vui lòng tải lên hình ảnh mã QR ngân hàng', 'danger');
        }
        return false;
    }

    let file = input.files[0];
    let allowedTypes = ['image/jpeg', 'image/png'];
    let allowedExtensions = /\.(jpe?g|png)$/i;

    if ( file.size > 500 * 1024 ) {
        $(input).addClass('is-invalid').val('');
        if ( showToast ) {
            toastBottom('Hình ảnh QR đang vượt quá dung lượng cho phép', 'danger');
        }
        return false;
    }

    if ( !allowedTypes.includes(file.type) && !allowedExtensions.test(file.name) ) {
        $(input).addClass('is-invalid').val('');
        if ( showToast ) {
            toastBottom('Hình ảnh QR tải lên không đúng định dạng', 'danger');
        }
        return false;
    }

    $(input).removeClass('is-invalid');
    return true;
}

$(document)
.off('input.cancelRegistrationReason', '.js-cancel-registration-reason')
