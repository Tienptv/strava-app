function toastBottom(text, class_ = '') {
    var x = document.getElementById('toast-bottom');

    if ( flagToast == 0 ) {
        x.innerHTML += text;
        x.className = 'show';
        flagToast = 1;

        if ( !class_ ) {
            x.classList.add('danger');
        } else {
            x.classList.add(class_);
        }
        
        setTimeout(function() {
            x.innerHTML = '';
            flagToast = 0; 
            x.className = x.className.replace('show', '');
            x.className = x.className.replace(class_, ''); 
        }, 5000);
    }
}

