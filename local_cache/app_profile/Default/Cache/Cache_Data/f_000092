function checkRequired(selectors) {
    for ( let selector of selectors ) {
        let $input = $(selector);
        let value = ($input.val() || '').trim();
        $input.removeClass('is-invalid');

        if ( value === '' ) {
            $input.addClass('is-invalid');
            return $input;
        }
    }
    return null;
}

function checkFormat(selector, rule) {
    let $input = $(selector);
    let value = ($input.val() || '').trim();

    let isValid = true;

    if ( value !== '' ) {
        if ( rule instanceof RegExp ) {
            isValid = rule.test(value);
        } else if ( typeof rule === 'function' ) {
            isValid = rule(value);
        }
    }

    if ( !isValid ) {
        $input.addClass('is-invalid');
        return $input;
    }

    return null;
}

