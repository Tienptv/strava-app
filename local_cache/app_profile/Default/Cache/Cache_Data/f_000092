let currentRequest = null;
let debounceTimer = null;

$('.input-q').on('input', function () {
    const $input = $(this);
    const value = $input.val();

    toggleClearQ();
    clearTimeout(debounceTimer);

    if ( value ) {
        debounceTimer = setTimeout(function () {
            if ( currentRequest && currentRequest.readyState !== 4 ) {
                currentRequest.abort();
            }

            currentRequest = $.ajax({
                type: 'post',
                url: './ajax-search',
                data: { q: value },
                cache: false,
                beforeSend: function () {
                    $('#hero-search-form button').addClass('loading');
                },
                success: function (response) {
                    if ( response.status === 'success' ) {
                        $('.search-autocomplete .search-locations').addClass('d-none');
                        $('.search-autocomplete .search-event').removeClass('d-none');
                        $('#text-search').text(value);
                        $('#search-event-result').html(response.data);
                    } else if ( response.status === 'error' ) {
                        toastBottom(response.data, 'danger');
                    }
                },
                complete: function (xhr, status) { 
                    $('#hero-search-form button').removeClass('loading');
                },
                error: handleAjaxError
            });
        }, 400);
    } else {
        $('.search-autocomplete .search-locations').removeClass('d-none');
        $('.search-autocomplete .search-event').addClass('d-none');
        $('#text-search').text('');
        $('#search-event-result').html('');
