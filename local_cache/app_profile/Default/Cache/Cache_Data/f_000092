$('#modalGroupBuyPayment .modal-footer .btn').on('click', function() {
    let id = $(this).attr('data-id');
    let url = $(this).attr('data-url');
    if ( !id || !url ) return;

    $.ajax({
        url: url,
        cache: false,
        type: 'post',
        data: {
            line: id,
            [csrfName]: csrfToken
        },
        beforeSend: function() {
            $('#modalGroupBuyPayment .modal-footer .btn').addClass('loading');
        },
        success: function (result) {
            toastBottom(result.msg, result.type);
            
            if ( result.type == 'success' ) {
                if ( result.status == 1 && result.payment_no ) {
                    $('.payment-status-text.' + result.payment_no).html('<span class="text-success"> Đã thanh toán </span>');
                    $('.groupbuy-payment-status.' + result.payment_no).prop('checked', true);
                }
                if ( result.status == 0 && result.payment_no && result.line ) {
                    $('.payment-status-text.' + result.line).html('<span class="text-danger"> Chưa thanh toán </span>');
                    $('.groupbuy-payment-status.' + result.line).prop('checked', false);
                }
                if ( result.amount_total ) {
                    $('#amount-total').html(result.amount_total + '₫');
                }
                if ( result.amount_discount ) {
                    $('#amount-discount').html(result.amount_discount + '₫');
                }

                $('#amount-loyalty').parent('li').addClass('d-none');
                if ( result.amount_loyalty ) {
                    $('#amount-loyalty').parent('li').removeClass('d-none');
                    $('#amount-loyalty').html(result.amount_loyalty + '₫');
                }

                if ( result.total ) {
                    $('#groupbuy-total').html( result.total + '₫');
                }
                if ( result.ticket_prices ) {
                    $('.group-ticket-price').each(function() {
                        let distanceID = $(this).attr('data-distance-id');
                        if ( Object.prototype.hasOwnProperty.call(result.ticket_prices, distanceID) ) {
                            $(this).html(result.ticket_prices[distanceID] + '₫');
                        }
                    });
                }
                if ( result.registration_prices ) {
                    $('.group-registration-price').each(function() {
                        let paymentNo = $(this).attr('data-payment-no');
                        if ( Object.prototype.hasOwnProperty.call(result.registration_prices, paymentNo) ) {
                            $(this).html(result.registration_prices[paymentNo] + '₫');
                        }
                    });
                }
                if ( result.paid_user_count ) {
                    $('#total-user-paid').html( result.paid_user_count );
                }
            }

            $('#modalGroupBuyPayment').modal('hide');
        },
        complete: function (xhr, status) {
            $('#modalGroupBuyPayment .modal-footer .btn').removeClass('loading');
        },
        error: handleAjaxError
    })
    .done(function( html ) { });
});

