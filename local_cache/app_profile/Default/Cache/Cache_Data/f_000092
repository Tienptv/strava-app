$('#users-address-validate').on('change', 'input.dob-main[id]', function () {
    if ( $(this).hasClass('not-required') ) { return false; }
    
    let $input = $(this);
    let $displayInput = $input.siblings('input.flatpickr-input[type="text"]').first();
    if ( !$displayInput.length ) $displayInput = $input;
    let id = $input.attr('id');
    let key = id.split('-')[1];
    let selectedDate = $input.val();
    let age_as_of = parseInt($input.attr('age-as-of') || 0);
    
    let age = getAge(selectedDate, age_as_of);
    $('.guardian-field-' + key).addClass('d-none');

    let minRequired = 0;
    let maxRequired = 18;
    
    if ( age < maxRequired ) {
        $('.guardian-field-' + key).removeClass('d-none');
    }

    /* */
    let ageGroupVal = $('#age_group-' + key).val();
    if ( ageGroupVal && ageGroupVal == 1 ) {
        $('.guardian-field-' + key).removeClass('d-none');
    }

    $input.siblings('.age-error').remove();
    $input.removeClass('is-invalid');
    $('#age_group-' + key).siblings('.age-error').remove();
    $('#age_group-' + key).removeClass('is-invalid');
    
    /* */
    let $ageGroup = $('#age_group-' + key);
    if ( $ageGroup.length ) {
        let selected = $ageGroup.val();
        let errorMessage = '';

        /* override by line combo */
        if ( typeof childAgeLimit !== 'undefined' ) {
            minRequired = childAgeLimit.min;
            maxRequired = childAgeLimit.max;
        }

        /* override by ticket */
        if ( $input.is('[date-min-age]') && 
            $input.is('[date-max-age]') &&
            parseInt($input.attr('date-min-age'), 10) > 0 &&
            parseInt($input.attr('date-max-age'), 10) > 0 ) {
            minRequired = parseInt($input.attr('date-min-age'), 10);
            maxRequired = parseInt($input.attr('date-max-age'), 10);
        }
        
        if ( selected === '1' && ( age > maxRequired || age < minRequired ) ) {
            errorMessage = `Độ tuổi không chính xác, nhóm <strong>Đối tượng</strong> trẻ em dành cho thành viên `;

            if ( minRequired == 0 ) {
                errorMessage += `nhỏ hơn ${maxRequired} tuổi`;
            } else {
                errorMessage += `từ ${minRequired} đến ${maxRequired} tuổi`;
            }
        }

        if ( selected === '0' && age < maxRequired ) {
            errorMessage = `Độ tuổi không chính xác, nhóm <strong>Đối tượng</strong> người lớn dành cho thành viên trên ${maxRequired} tuổi`;
        }

        if ( errorMessage !== '' ) {
            $('<em class="mt-1 d-block text-danger line-1-2 age-error"> <small>' + errorMessage + '</small> </em>').insertAfter($displayInput);
            $input.addClass('is-invalid');

            $('<em class="mt-1 d-block text-danger line-1-2 age-error"><small>' + errorMessage + '</small></em>').insertAfter($('#age_group-' + key));
            $('#age_group-' + key).addClass('is-invalid');
            $('#accordion' + key).addClass('is-invalid');
        }
    } else {
        /* override by ticket */
        let minAge = parseInt($input.attr('date-min-age'), 10);
        let maxAge = parseInt($input.attr('date-max-age'), 10);

        let hasMin = $input.is('[date-min-age]') && minAge > 0;
        let hasMax = $input.is('[date-max-age]') && maxAge > 0;

        if ( hasMin || hasMax ) {
            let isInvalidAge = false;
            let errorMessage = 'Độ tuổi không chính xác, loại vé này chỉ dành cho thành viên ';

            if ( hasMin && hasMax ) {
                isInvalidAge = age < minAge || age > maxAge;
                errorMessage += `từ ${minAge} đến ${maxAge} tuổi`;
            } else if ( hasMin ) {
                isInvalidAge = age < minAge;
                errorMessage += `từ ${minAge} tuổi trở lên`;
            } else if ( hasMax ) {
                isInvalidAge = age > maxAge;
                errorMessage += `tối đa ${maxAge} tuổi`;
            }

            if ( isInvalidAge ) {
                $('<em class="mt-1 d-block text-danger line-1-2 age-error"><small>' + errorMessage + '</small></em>').insertAfter($displayInput);
                $input.addClass('is-invalid');

                $('<em class="mt-1 d-block text-danger line-1-2 age-error"><small>' + errorMessage + '</small></em>').insertAfter($('#age_group-' + key));
                $('#accordion' + key).addClass('is-invalid');
            }
        }
    }
    
    /* */
    let $select = $('#t_shirt_size-' + key);
    if ( $select.length ) {
        let $options = $select.find('option');
        let $childOptions = $options.filter('.child');

        let maxAge = 18;
        if ( typeof ageThreshold !== 'undefined' ) {
            maxAge = ageThreshold;
        }

        if ( $childOptions.length ) {
            if ( age < maxAge ) {
                $options.each(function() {
                    $(this).toggle($(this).hasClass('child'));
                });
            } else {
                $options.each(function() {
                    $(this).toggle(!$(this).hasClass('child'));
                });
            }
            if ( !$select.find('option:selected').is(':visible') ) {
                $select.val('');
            }
        }
    }
});

