$('#buyer-vat').change(function() {
    let calculate = $(this).data('calculate') || 0;
    let id = $(this).data('id') || 0;
    let urlAjax = $(this).attr('data-url');

    let vat = 0;
    if ( $(this).is(':checked') ) { vat = 1; }

    if ( calculate && urlAjax ) {
        $.ajax({
            url: urlAjax,
            cache: false,
            type: 'post',
            data: {
                id: id,
                vat: vat,
                [csrfName]: csrfToken
            },
            beforeSend: function() {
                $('.register-step-04-validate').addClass('loading');
            },
            success: function (result) {
                if ( result.status == 'success' ) {
                    let rows = [
                        { key: 'subtotal', label: 'Tạm tính' },
                        { key: 'purchase_discount', label: 'Ưu đãi mua nhiều', class: 'text-danger' },
                        { key: 'discount', label: 'Mã giảm giá: <code class="text-success fs-16 fw-bold">{coupon}</code>', class: 'text-danger' },
                        { key: 'payment_method_discount', label: 'Ưu đãi thanh toán (-{payment_method_discount_percent}%)', class: 'text-danger' },
                        { key: 'loyalty', label: 'Sử dụng Xu', class: 'text-danger' },
                        { key: 'vat_fee', label: 'Xuất hóa đơn (+{fee_vat}% VAT)' },
                        { key: 'fee', label: 'Phí giao dịch (+{fee_payment}%)' }
                    ];

                    let html = '';
                    rows.forEach(row => {
                        let val = result[row.key];
                        if ( val ) {
                            let label = row.label
                                .replace('{coupon}', result.discount_code ?? '')
                                .replace('{payment_method_discount_percent}', result.payment_method_discount_percent ?? 0)
                                .replace('{fee_vat}', result.fee_vat ?? '')
                                .replace('{fee_payment}', result.fee_payment ?? '');
                            let cls = row.class ?? '';
                            html += `<div class="d-flex align-items-center mt-2"> <span>${label}</span> <strong class="ms-auto ${cls}">${val.toLocaleString()}₫</strong> </div>`;
                            if ( row.key === 'discount' ) {
                                html += getDiscountStandardPriceNote(result);
                            }
                        }
                    });

                    if ( result.total !== undefined && result.total !== null ) {
                        html += `<hr class="double my-2" /> <div class="mt-2 d-flex align-items-center h4 mb-0"> <strong>Tổng thanh toán</strong> <strong class="ms-auto">${result.total.toLocaleString()}₫</strong> </div>`;
                    }

                    $('#show-order-price').html(html);
                    $('#ticket-total').text(result.total.toLocaleString() + '₫');
                }

                if ( result.status == 'error' ) {
                    toastBottom(result.msg);
                }
            },
            complete: function (xhr, status) {
                $('.register-step-04-validate').removeClass('loading');
            },
            error: handleAjaxError
        })
        .done(function( html ) { });
    }
});

