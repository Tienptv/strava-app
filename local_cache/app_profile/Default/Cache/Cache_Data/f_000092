function disable_field_user_info() {
    if ( $('#disable-field-user-info').length ) {
        let id = $('#disable-field-user-info').attr('data-id');
        let field = $('#disable-field-user-info').attr('data-field');

        if ( !id || !field ) return;
        
        if ( field === 'all' ) {
            $('form#users-address-validate input').prop('readonly', true);
            $('form#users-address-validate select').prop('disabled', true);
            $('button.users-address-validate').prop('disabled', true);
        } else {
            let arrField = field.split(", ");
            arrField.forEach(function(element) {
                $('#' + element + '-' + id).prop('readonly', true);
            });
        }
    }
}

