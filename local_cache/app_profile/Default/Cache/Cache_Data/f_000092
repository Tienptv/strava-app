function isValidDateInput(value) {
    const match = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if ( !match ) return false;

    const day = Number(match[1]);
    const month = Number(match[2]);
    const year = Number(match[3]);
    const date = new Date(year, month - 1, day);

    return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day;
}

function initFlatpickrs(root = document) {
    if ( !root ) return;

    root.querySelectorAll('.flatpickr').forEach(input => {
        if ( input._flatpickr ) return;

        let minDate = input.getAttribute('data-min-date');
        const maxDate = input.getAttribute('data-max-date') || null;
        const dateFormat = input.getAttribute('data-date-format') || 'd/m/Y';
        const altFormat = input.getAttribute('data-alt-format');
        const clickOpens = input.getAttribute('data-click-opens') !== 'false';

        if ( !minDate ) minDate = 'today';
        if ( minDate === 'none' ) minDate = null;
        if ( minDate === '100-years-ago' ) {
            minDate = new Date();
            minDate.setFullYear(minDate.getFullYear() - 100);
            minDate.setHours(0, 0, 0, 0);
        }

        flatpickr(input, {
            dateFormat: dateFormat,
            altInput: Boolean(altFormat),
            altFormat: altFormat || 'F j, Y',
            altInputClass: altFormat ? 'form-control flatpickr-input' : undefined,
            locale: 'vn',
            minDate: minDate,
            maxDate: maxDate,
            disableMobile: 'true',
            allowInput: !altFormat,
            clickOpens: clickOpens,
            onReady: function(selectedDates, dateStr, instance) {
                if ( !instance.altInput ) return;

                let typedValue = null;
                let selectingFromCalendar = false;
                const fieldWrapper = instance.altInput.closest('.form-floating');
                const toggle = fieldWrapper ? fieldWrapper.querySelector('.flatpickr-toggle') : null;
                instance.altInput.removeAttribute('readonly');
                instance.altInput.setAttribute('inputmode', instance.input.getAttribute('inputmode') || 'numeric');
                instance.altInput.setAttribute('pattern', instance.input.getAttribute('pattern') || '[0-9]*');

                const removeAgeErrors = function() {
                    if ( !fieldWrapper ) return;
                    fieldWrapper.querySelectorAll('.age-error').forEach(error => error.remove());

                    if ( instance.input.classList.contains('dob-main') ) {
                        const key = instance.input.id.split('-').pop();
                        const ageGroup = document.getElementById('age_group-' + key);
                        if ( ageGroup ) {
                            ageGroup.classList.remove('is-invalid');
                            ageGroup.parentElement.querySelectorAll('.age-error').forEach(error => error.remove());
                        }
                    }
                };
                const showDateFormatError = function() {
                    removeAgeErrors();
                    instance.altInput.classList.add('is-invalid');
                    instance.input.classList.add('is-invalid');

                    if ( instance.altInput ) {
                        instance.altInput.insertAdjacentHTML(
                            'afterend',
                            '<em class="mt-1 d-block text-danger line-1-2 age-error date-format-error"><small>Ngày sinh không hợp lệ hoặc không đúng định dạng</small></em>'
                        );
                    }
                };

                instance.altInput.addEventListener('input', function() {
                    let caretPosition = this.selectionStart;

                    if ( instance.config.altFormat === 'd/m/Y' ) {
                        const rawValue = this.value;
                        const rawCaret = caretPosition === null ? rawValue.length : caretPosition;
                        const digitsBeforeCaret = rawValue.slice(0, rawCaret).replace(/\D/g, '').length;
                        const caretWasAfterSeparator = rawCaret > 0 && /\D/.test(rawValue.charAt(rawCaret - 1));
                        const digits = rawValue.replace(/\D/g, '').slice(0, 8);
                        const formattedValue = [digits.slice(0, 2), digits.slice(2, 4), digits.slice(4, 8)]
                            .filter(Boolean)
                            .join('/');

                        caretPosition = 0;
                        let digitCount = 0;
                        for ( let i = 0; i < formattedValue.length && digitCount < digitsBeforeCaret; i++ ) {
                            caretPosition = i + 1;
                            if ( /\d/.test(formattedValue.charAt(i)) ) digitCount++;
                        }
                        if ( caretWasAfterSeparator && formattedValue.charAt(caretPosition) === '/' ) {
                            caretPosition++;
                        }

                        this.value = formattedValue;
                    }

                    const restoreCaret = () => {
                        if ( caretPosition !== null ) this.setSelectionRange(caretPosition, caretPosition);
                    };

                    typedValue = this.value.trim();
                    this.classList.remove('is-invalid');
                    instance.input.classList.remove('is-invalid');
                    removeAgeErrors();

                    if ( typedValue.length === 10 && isValidDateInput(typedValue) ) {
                        const parsedDate = instance.parseDate(typedValue, instance.config.altFormat);
                        if ( parsedDate && instance.isEnabled(parsedDate) ) {
                            instance.setDate(typedValue, true, instance.config.altFormat);
                            restoreCaret();
                            return;
                        }
                    }

                    instance.clear(false);
                    instance.altInput.value = typedValue;
                    if ( typedValue.length === 10 ) showDateFormatError();
                    restoreCaret();
                });
                instance.altInput.addEventListener('focus', function() {
                    instance.close();
                });
                if ( toggle && toggle.classList.contains('flatpickr-toggle') ) {
                    const openCalendar = function(event) {
                        event.preventDefault();
                        instance.open();
                    };

                    toggle.addEventListener('click', openCalendar);
                    toggle.addEventListener('keydown', function(event) {
                        if ( event.key === 'Enter' || event.key === ' ' ) openCalendar(event);
                    });
                }
                instance.calendarContainer.addEventListener('mousedown', function() {
                    selectingFromCalendar = true;
                });
                instance.config.onChange.push(function() {
                    selectingFromCalendar = false;
                    typedValue = null;
                    instance.altInput.classList.remove('is-invalid');
                    instance.input.classList.remove('is-invalid');
                    removeAgeErrors();
                });
                instance.altInput.addEventListener('blur', function() {
                    if ( selectingFromCalendar ) {
                        selectingFromCalendar = false;
                        typedValue = null;
                        return;
                    }
                    if ( typedValue === null || typedValue === '' ) return;

                    if ( typedValue.length !== 10 || !isValidDateInput(typedValue) || instance.input.value === '' ) {
                        showDateFormatError();
                    }
                    typedValue = null;
                });
            }
        });
    });
}

