    validateCancelRegistrationImage(this);
})
.off('submit.cancelRegistration', '#cancel-registration-form')
.on('submit.cancelRegistration', '#cancel-registration-form', function(e) {
    e.preventDefault();

    let form = this;
    let modal = $('#modalCancel');
    let cancelButton = modal.data('cancel-registration-button');
    let actionButton = cancelButton && cancelButton.length
        ? cancelButton.closest('.registration-item').find('.actions > .dropdown-toggle')
        : $();
    let reason = form.querySelector('.js-cancel-registration-reason');
    let input = this.querySelector('.js-cancel-registration-image');
    let isValid = true;

    if ( reason && !validateCancelRegistrationReason(reason) ) {
        isValid = false;
    }

    if ( input && !validateCancelRegistrationImage(input, isValid) ) {
        isValid = false;
    }

    if ( !isValid ) {
        return false;
    }

    $.ajax({
        url: $(form).attr('action'),
        cache: false,
        type: 'post',
        data: new FormData(form),
        processData: false,
        contentType: false,
        dataType: 'json',
        beforeSend: function() {
            $('#modalCancel button[type="submit"]').prop('disabled', true).addClass('loading');
            actionButton.addClass('disabled');
        },
        success: function(response) {
            if ( response.status == 'success' ) {
                let registrationItem = cancelButton.closest('.registration-item');

                registrationItem
                    .find('.js-registration-cancel-status')
                    .html('<em class="text-danger fs-14">Đang xử lý hoàn tiền</em>');
