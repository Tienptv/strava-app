$(document).on('keyup', '.search-profile', function(){
    let keyword = $(this).val().toLowerCase();
    let key = $(this).data('key');

    $(this).closest('ul').find('li').each(function(index){
        if ( index === 0 ) return;
        if ( $(this).data('key') == key ) {
            $(this).toggle($(this).text().toLowerCase().indexOf(keyword) > -1);
        }
    });
});

$(document).on('click', '.js-confirm-action', function (e) {
    e.preventDefault();

    let $el = $(this);
    let url = $el.attr('href');
    let title = $el.attr('title') || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
    let needReload = String($el.data('reload')) === '1';

    Swal.fire({
      title: title,
      showCancelButton: true,
      confirmButtonText: 'XÁC NHẬN',
      cancelButtonText: 'ĐÓNG',
      confirmButtonColor: '#d33',
      allowOutsideClick: false,
      allowEscapeKey: false,
      reverseButtons: true
    }).then((result) => {
    if ( result.value ) {
        if ( needReload ) {
          window.location.href = url; return;
        }

        $.ajax({
          url: url,
          type: 'GET',
          dataType: 'json',
          success: function (res) {
            Swal.close();

            if ( res.status == 400 ) {
              toastBottom(res.msg ?? 'Đã xảy ra lỗi', 'danger');
            }

            if ( res.status == 200 ) {
                toastBottom(res.msg ?? 'Đã xảy ra lỗi', 'success');
              window.location.replace(res.redirect);
            }
          },
          complete: function (xhr, status) { },
          error: handleAjaxError
        });
      }
    });
});

function renderComputedOrderTotal(result) {
    let rows = [
        { key: 'subtotal', label: 'Tạm tính' },
        { key: 'purchase_discount', label: 'Ưu đãi mua nhiều', class: 'text-danger' },
        { key: 'discount', label: 'Mã giảm giá: <code class="text-success fs-16 fw-bold">{coupon}</code>', class: 'text-danger' },
        { key: 'payment_method_discount', label: 'Ưu đãi thanh toán (-{payment_method_discount_percent}%)', class: 'text-danger' },
        { key: 'loyalty', label: 'Sử dụng Xu', class: 'text-danger' },
        { key: 'vat_fee', label: 'Xuất hóa đơn (+{fee_vat}% VAT)' },
        { key: 'fee', label: 'Phí giao dịch (+{fee_payment}%)' }
    ];

    let html = '';
    rows.forEach(row => {
        let val = result[row.key];
        if ( val ) {
            let label = row.label
                .replace('{coupon}', result.discount_code ?? '')
                .replace('{payment_method_discount_percent}', result.payment_method_discount_percent ?? 0)
                .replace('{fee_vat}', result.fee_vat ?? '')
                .replace('{fee_payment}', result.fee_payment ?? '');
            let cls = row.class ?? '';
            html += `<div class="d-flex align-items-center mt-2"> <span>${label}</span> <strong class="ms-auto ${cls}">${val.toLocaleString()}₫</strong> </div>`;
            if ( row.key === 'discount' ) {
                html += getDiscountStandardPriceNote(result);
            }
        }
    });

    if ( result.total !== undefined && result.total !== null ) {
        html += `<hr class="double my-2" /> <div class="mt-2 d-flex align-items-center h4 mb-0"> <strong>Tổng thanh toán</strong> <strong class="ms-auto">${result.total.toLocaleString()}₫</strong> </div>`;
    }

    $('#show-order-price').html(html);
    $('#ticket-total').text(result.total.toLocaleString() + '₫');

    if ( window.glightboxInstance ) {
        window.glightboxInstance.destroy();
    }

    window.glightboxInstance = GLightbox({
        selector: '[data-glightbox]'
    });
}

function parseVndAmount(value) {
    return parseInt(String(value || '').replace(/[^\d]/g, ''), 10) || 0;
}

function formatVndAmount(value) {
    return (parseInt(value, 10) || 0).toLocaleString() + '₫';
}

function getSummaryLine(addonKey) {
    let key = String(addonKey || '');
    return $('#summary-total .cart-list li.line-' + key);
}

function syncSummaryLineAddons(addonKey) {
    let summaryLine = getSummaryLine(addonKey);
    if ( !summaryLine.length ) {
        return;
    }

    let price = summaryLine.children('span').first();
    if ( !price.length ) {
        return;
    }

    if ( summaryLine.data('base-price') === undefined ) {
        summaryLine.data('base-price', parseVndAmount(price.text()));
    }

    let labels = [];
    let addonTotal = 0;
    $('.addon-item[data-key="' + addonKey + '"] .addon-checkbox:checked').each(function () {
        let addonItem = $(this).closest('.addon-item');
        let label = addonItem.data('label');

        if ( label && !labels.includes(label) ) {
            labels.push(label);
        }

        addonTotal += parseVndAmount(addonItem.data('price'));
    });

    price.text(formatVndAmount(parseVndAmount(summaryLine.data('base-price')) + addonTotal));

    let addons = summaryLine.children('em').last();
    if ( labels.length ) {
        if ( !addons.length ) {
            addons = $('<em></em>').appendTo(summaryLine);
        }

        addons.text(labels.join(', '));
    } else {
        addons.remove();
    }
}

$(document)
.off('click.addonItem', '.addon-item')
.on('click.addonItem', '.addon-item', function (e) {
    if ( $(this).hasClass('disabled') ) {
        return;
    }

    if ( $(e.target).is('input[type="checkbox"]') ) {
        return;
    }

    let checkbox = $(this).find('.addon-checkbox');
    if ( checkbox.prop('disabled') ) {
        return;
    }

    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
})
.off('change.addonItem', '.addon-checkbox')
.on('change.addonItem', '.addon-checkbox', function () {
    let checkbox = $(this);
    let addonItem = checkbox.closest('.addon-item');
    let checked = this.checked;
    let addonID = addonItem.data('id');
    let addonKey = addonItem.data('key');

    addonItem.toggleClass('checked', checked);
    if ( $('#users-address-validate .addon-items[data-addon-required="1"] .addon-checkbox:checked').length ) {
        $('#users-address-validate .addon-items[data-addon-required="1"]').removeClass('is-invalid');
    } else {
        addonItem.closest('.addon-items').removeClass('is-invalid');
    }
    syncSummaryLineAddons(addonKey);

    if ( !addonID || !addonKey ) {
        return;
    }

    $.ajax({
        url: '../../compute-order-total',
        cache: false,
        type: 'post',
        data: {
            action: checked ? 'add' : 'remove',
            addon: addonID,
            key: addonKey,
            [csrfName]: csrfToken
        },
        beforeSend: function() {
            checkbox.prop('disabled', true);
            $('.register-step-04-validate').addClass('loading');
        },
        success: function (result) {
            if ( result.status == 'success' && result.total !== undefined && result.total !== null ) {
                renderComputedOrderTotal(result);
            }

            if ( result.status == 'error' ) {
                toastBottom(result.msg);
            }
        },
        complete: function () {
            checkbox.prop('disabled', addonItem.hasClass('disabled'));
            $('.register-step-04-validate').removeClass('loading');
        },
        error: function (xhr, status, error) {
            handleAjaxError(xhr, status, error);
        }
    });
});

function autoSelectFreeAddonItems() {
    $('.addon-item[data-price="0"]').each(function () {
        let addonItem = $(this);
        let checkbox = addonItem.find('.addon-checkbox');

        if ( !checkbox.length ) {
            addonItem.addClass('disabled');
            return;
        }

        if ( !checkbox.prop('checked') && !checkbox.prop('disabled') ) {
            addonItem.trigger('click');
        }

        addonItem.addClass('disabled');
        checkbox.prop('disabled', true);
    });
}

$(function () {
    autoSelectFreeAddonItems();
});
