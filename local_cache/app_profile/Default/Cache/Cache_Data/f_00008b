/* */
.homepage-slide {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(8, minmax(0px, 1fr));
    gap: 12px;
    grid-auto-rows: 1fr;
}
.homepage-slide-left {
    grid-area: span 2 / span 8 / span 2 / span 8;
    position: relative;
    height: 100%;
}
.homepage-slide-right {
    grid-area: span 1 / span 4 / span 1 / span 4;
}
@media (min-width: 992px) {
    .homepage-slide-left {
        grid-area: span 2 / span 5 / span 2 / span 5;
    }
    .homepage-slide-right {
        grid-area: span 1 / span 3 / span 1 / span 3;
    }
}
.homepage-slide-right a {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}
.homepage-slide-right a img {
    position: absolute;
    object-fit: cover;
    object-position: top;
    width: 100%;
    height: 100%;
}
.swiper-pagination-bullet-active {
    border-color: var(--bs-primary) !important;
}
.homepage-slide-left .swiper-container {
    min-height: 100%;
}
.homepage-slide-left .swiper-container .swiper {
    height: 100%;
}
.homepage-slide-left .swiper-container .swiper-slide a {
    display: block;
}
.homepage-slide-left .swiper-container .swiper-slide a img {
    height: 100%;
    min-height: 100%;
    object-fit: cover;
}

